---
import WebsHighlight from './WebsHighlight.astro';

const { t, locale } = Astro.props;
const h = t.hero;
const initials = h.name
  .split(' ')
  .map((word) => word[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();

const toolAbbr = {
  Illustrator: 'Ai',
  Photoshop: 'Ps',
  InDesign: 'Id',
  Figma: 'Fi',
  WordPress: 'W',
  Canva: 'Cv',
  Affinity: 'Af',
  'IA generativa': 'AI',
  'Generative AI': 'AI',
  'Claude Code': 'CC',
  'Claude Design': 'CD',
};
---

<section class="hero" id="about">
  <div class="wrap">
    <div class="hero-top">
      <div class="hero-copy">
        <h1 class="hero-name">{h.name}</h1>
        <p class="hero-role">{h.role}</p>
        <p class="hero-bio"><strong>{h.bioLead}</strong> {h.bio}</p>

        <div class="hero-cv-row">
          <a class="btn-primary" href="/cv-franco-colucci.pdf" download>
            {h.cvButton}
          </a>
          <span class="cv-note">{h.cvNote}</span>
        </div>

        <div class="hero-tools-row">
          {h.tools.map((tool) => (
            <span class="hero-tool-badge" title={tool} aria-label={tool}>
              {toolAbbr[tool] || tool.slice(0, 2)}
            </span>
          ))}
        </div>
      </div>

      <div class="hero-photo">
        <div class="hero-photo-frame">
          {h.photoSrc ? (
            <img src={h.photoSrc} alt={h.name} />
          ) : (
            <span class="hero-photo-placeholder">{initials}</span>
          )}
        </div>
        <span class="hero-blob hero-blob-coral" aria-hidden="true"></span>
        <span class="hero-blob hero-blob-teal" aria-hidden="true"></span>
      </div>
    </div>

    <WebsHighlight t={t} />
  </div>
</section>
