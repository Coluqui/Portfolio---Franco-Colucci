---
import Cover from './Cover.astro';
import WebsHighlight from './WebsHighlight.astro';

const { t, locale } = Astro.props;
const h = t.hero;
---

<section class="hero" id="about">
  <div class="cover-wrap">
    <Cover />
  </div>

  <div class="wrap">
    <p class="hero-kicker">{h.kicker}</p>
    <h1 class="hero-name">{h.name}</h1>
    <p class="hero-bio">{h.bio}</p>

    <div class="hero-cv-row">
      <a class="btn-primary" href="/cv-franco-colucci.pdf" download>
        {h.cvButton}
      </a>
      <span class="cv-note">{h.cvNote}</span>
    </div>

    <div class="hero-meta-grid">
      <div class="hero-meta-block">
        <h3>{h.toolsTitle}</h3>
        <div class="tag-list">
          {h.tools.map((tool) => <span class="chip">{tool}</span>)}
        </div>
      </div>

      <div class="hero-meta-block">
        <h3>{h.skillsTitle}</h3>
        <div class="tag-list">
          {h.skills.map((skill) => <span class="chip">{skill}</span>)}
        </div>
      </div>

      <div class="hero-meta-block">
        <h3>{h.languagesTitle}</h3>
        <ul class="lang-list">
          {h.languages.map((lang) => (
            <li>{lang.name} — <span>{lang.level}</span></li>
          ))}
        </ul>
      </div>

      <div class="hero-meta-block">
        <h3>{h.companiesTitle}</h3>
        <div class="tag-list">
          {h.companies.map((company) => <span class="chip">{company}</span>)}
        </div>
      </div>
    </div>

    <WebsHighlight t={t} />
  </div>
</section>
