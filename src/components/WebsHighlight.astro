---
const { t } = Astro.props;
const w = t.webs;
---

<div class="webs-highlight">
  <div class="wrap webs-highlight-inner">
    <h3>{w.title}</h3>
    <div class="webs-links">
      {w.items.map((item) => (
        <a class="webs-link" href={item.url} target="_blank" rel="noopener noreferrer">
          {item.name}
          <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </div>
</div>
