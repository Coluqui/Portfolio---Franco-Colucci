---
const { t, locale } = Astro.props;
const w = t.works;
---

<section id="works">
  <div class="wrap">
    <div class="section-heading">
      <h2>{w.title}</h2>
      <p>{w.subtitle}</p>
    </div>

    <div class="project-cards-grid">
      {w.groups.map((group) => (
        <a class="project-card" href={`/${locale}/trabajos/${group.slug}/`}>
          <div class="project-card-image">
            <img src={group.items[0].src} alt={group.items[0].alt} loading="lazy" />
          </div>
          <h3 class="project-card-title">{group.client}</h3>
          <p class="project-card-meta">
            {group.categories.map((cat) => w.categoryLabels[cat]).join(', ')}
          </p>
        </a>
      ))}
    </div>
  </div>
</section>
