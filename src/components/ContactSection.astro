---
const { t } = Astro.props;
const c = t.contact;
---

<section id="contact">
  <div class="wrap">
    <div class="section-heading">
      <h2>{c.title}</h2>
      <p>{c.subtitle}</p>
    </div>

    <div class="direct-links">
      <a class="direct-link brand-email" href={`mailto:${c.email}`}>
        <span class="direct-link-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
            <path d="m3 7 9 6 9-6"></path>
          </svg>
        </span>
        <span class="direct-link-text">
          <span class="direct-link-label">Email</span>
          <span class="direct-link-value">{c.email}</span>
        </span>
      </a>
      <a class="direct-link brand-whatsapp" href={c.whatsapp} target="_blank" rel="noopener noreferrer">
        <span class="direct-link-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2a10 10 0 0 0-8.5 15.2L2 22l4.9-1.5A10 10 0 1 0 12 2zm5.6 14.2c-.2.6-1.2 1.2-1.7 1.3-.4.1-1 .1-1.6-.1-.4-.1-.9-.3-1.5-.6-2.6-1.1-4.3-3.8-4.4-4-.1-.2-1-1.3-1-2.5s.6-1.8.9-2c.2-.2.5-.3.7-.3h.5c.2 0 .4 0 .6.4.2.5.7 1.7.8 1.8.1.1.1.3 0 .5-.1.2-.1.3-.3.5l-.4.5c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1.2-.2.7-.8.9-1.1.2-.3.4-.2.6-.1.2.1 1.5.7 1.7.8.2.1.4.2.4.3.1.2.1.6-.1 1.2z"></path>
          </svg>
        </span>
        <span class="direct-link-text">
          <span class="direct-link-label">{c.whatsappLabel}</span>
          <span class="direct-link-value">{c.whatsappDisplay}</span>
        </span>
      </a>
      <a class="direct-link brand-linkedin" href={c.linkedin} target="_blank" rel="noopener noreferrer">
        <span class="direct-link-icon direct-link-icon-text" aria-hidden="true">in</span>
        <span class="direct-link-text">
          <span class="direct-link-label">LinkedIn</span>
          <span class="direct-link-value">/francocolucci93</span>
        </span>
      </a>
    </div>
  </div>
</section>
