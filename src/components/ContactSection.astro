---
const { t } = Astro.props;
const c = t.contact;
---

<section id="contact">
  <div class="wrap">
    <div class="section-heading">
      <h2>{c.title}</h2>
      <p>{c.subtitle}</p>
    </div>

    <div class="contact-social-row">
      <a
        class="social-btn brand-email"
        href={`mailto:${c.email}`}
        aria-label={`Email: ${c.email}`}
        title={c.email}
      >
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M3 6.5 12 13l9-6.5" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          <rect x="3" y="5" width="18" height="14" rx="2.5" stroke="#fff" stroke-width="1.8"/>
        </svg>
      </a>
      <a
        class="social-btn brand-whatsapp"
        href={c.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${c.whatsappLabel}: ${c.whatsappDisplay}`}
        title={c.whatsappDisplay}
      >
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2a10 10 0 0 0-8.5 15.2L2 22l4.9-1.5A10 10 0 1 0 12 2zm5.6 14.2c-.2.6-1.2 1.2-1.7 1.3-.4.1-1 .1-1.6-.1-.4-.1-.9-.3-1.5-.6-2.6-1.1-4.3-3.8-4.4-4-.1-.2-1-1.3-1-2.5s.6-1.8.9-2c.2-.2.5-.3.7-.3h.5c.2 0 .4 0 .6.4.2.5.7 1.7.8 1.8.1.1.1.3 0 .5-.1.2-.1.3-.3.5l-.4.5c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1.2-.2.7-.8.9-1.1.2-.3.4-.2.6-.1.2.1 1.5.7 1.7.8.2.1.4.2.4.3.1.2.1.6-.1 1.2z"></path>
        </svg>
      </a>
      <a
        class="social-btn brand-linkedin"
        href={c.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        title="LinkedIn"
      >
        <svg viewBox="0 0 24 24" fill="#fff">
          <path d="M6.94 8.5H3.56V20.4h3.38V8.5zM5.25 3.6a1.96 1.96 0 100 3.92 1.96 1.96 0 000-3.92zM20.4 13.4c0-3.4-1.8-5-4.2-5-1.6 0-2.6.7-3.1 1.5h-.05V8.5H9.8V20.4h3.38v-6.3c0-1.65.98-2.6 2.2-2.6 1.2 0 1.9.83 1.9 2.55v6.35h3.12v-6.95z"/>
        </svg>
      </a>
    </div>
  </div>
</section>
